# Dependencies
node_modules/
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Environment Variables
.env
.env.local
*.env

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build and logs
build/
dist/
*.log

# Large data formats and archives
*.nc
*.zip
*.parquet
*.feather
*.h5
*.hdf5

# Data directory contents (preserve directory structures via .gitkeep)
data/*.csv
data/raw/*
!data/raw/.gitkeep
!data/raw/*/
data/raw/**/*
!data/raw/**/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*/
data/processed/**/*
!data/processed/**/.gitkeep

# Machine Learning artifacts
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.onnx
ml/models/*.pt
ml/models/*.pth
!ml/models/.gitkeep
!ml/evaluation/.gitkeep
